Macrophages_Immunecells_filtered = sc.read("Finalshell1.0/data/Macrophages_Immunecells_filtered.h5ad")

CD4_filtered.obs['cluster_cpdb'] = CD4_filtered.obs['cluster']
Macrophages_Immunecells_filtered.obs['cluster_cpdb'] = Macrophages_Immunecells_filtered.obs['cluster06']

CD4_filtered.obs.set_index('index', inplace=True)
Macrophages_Immunecells_filtered.obs.set_index('index', inplace=True)

merge = {"CD4":CD4_filtered, "Macrophages":Macrophages_Immunecells_filtered}
merge = sc.concat((merge),join="outer",label="cell_type")

import pandas as pd
import seaborn as sns
import matplotlib.pyplot as plt
from scipy.stats import spearmanr

# 1. 使用 pd.crosstab 快速统计每个 sample 中所有细胞亚群的数量
# 每一行是一个 sample，每一列是一个 cluster，值是细胞数量
cell_counts = pd.crosstab(merge.obs['sample'], merge.obs['cluster_cpdb'])

# 2. 定义你要计算分母的两个大类的 cluster 列表
cd4_t_clusters = ['Tregs', 'Memory CD4 T cells', 'Tfh', 'Naïve CD4 T cells']
mac_clusters = ['SPP1+', 'CXCL9+', 'IL1B+']

# 3. 计算每个 sample 的 CD4 T 细胞总数 和 巨噬细胞总数
cd4_total = cell_counts[[c for c in cd4_t_clusters if c in cell_counts.columns]].sum(axis=1)
mac_total = cell_counts[[c for c in mac_clusters if c in cell_counts.columns]].sum(axis=1)

# 4. 计算占比，并在最后乘以 100 转换为百分比数值 (0-100)
il1b_prop = (cell_counts.get('IL1B+', 0) / mac_total).fillna(0) * 100
tregs_prop = (cell_counts.get('Tregs', 0) / cd4_total).fillna(0) * 100

# 5. 合并为 DataFrame，更新列名
data = pd.DataFrame({
    'IL1B+ percentage': il1b_prop,
    'Tregs percentage': tregs_prop
})

# 6. 绘制散点图和趋势线
plt.figure(figsize=(8, 6))
sns.regplot(x='IL1B+ percentage', y='Tregs percentage', data=data, 
            scatter_kws={'s': 50}, line_kws={'color': 'red'})

# 进行 Spearman 相关性分析
corr, p_value = spearmanr(data['IL1B+ percentage'], data['Tregs percentage'])

# 7. 在图中标注相关系数和 p 值，并更新坐标轴标签为百分比
plt.title(f'Spearman correlation: {corr:.2f}, p-value: {p_value:.3e}')
plt.xlabel('IL-1β+ proportion in Macrophages (%)')
plt.ylabel('Tregs proportion in CD4+ T cells (%)')

