import scanpy as sc
import pandas as pd
import numpy as np

%config InlineBackend.figure_format = 'retina'

sc.settings.set_figure_params(dpi=50, dpi_save=300, figsize=(4, 4))

import os
os.chdir("/home/zhanglz3")
os.getcwd()

pan_new = sc.read_h5ad('Finalshell1.0/data/pan.h5ad')

sc.pp.normalize_total(pan_new, target_sum=1e4)
sc.pp.log1p(pan_new)

sc.pp.highly_variable_genes(pan_new, min_mean=0.0125, max_mean=5, min_disp=0, n_top_genes=2000)

pan_new.raw = pan_new
pan_new = pan_new[:, pan_new.var.highly_variable]
pan_new

sc.pp.regress_out(pan_new, ['total_counts', 'pct_counts_mt'])
sc.pp.scale(pan_new, max_value=10)
sc.tl.pca(pan_new, svd_solver='arpack')
sc.pl.pca_variance_ratio(pan_new, log=True)

sc.external.pp.bbknn(pan_new, batch_key= "sample",n_pcs=10)

sc.tl.umap(pan_new)

sc.tl.leiden(pan_new,resolution = 2)
