import sctour as sct

Tumor = sc.read('OOC7/Tumor_0928.h5ad')
Tumor

sc.pp.calculate_qc_metrics(Tumor, percent_top=None, log1p=False, inplace=True)

sc.pp.highly_variable_genes(Tumor, subset=True)

Tumor.X = Tumor.X.astype('float32') # convert data to float32 type
tnode = sct.train.Trainer(Tumor, loss_mode='mse')
tnode.train()

Tumor.obs['ptime'] = tnode.get_time()

#zs represents the latent z from variational inference, and pred_zs represents the latent z from ODE solver
#mix_zs represents the weighted combination of the two, which is used for downstream analysis
mix_zs, zs, pred_zs = tnode.get_latentsp(alpha_z=0.5, alpha_predz=0.5)
Tumor.obsm['X_TNODE'] = mix_zs

Tumor.obsm['X_VF'] = tnode.get_vector_field(Tumor.obs['ptime'].values, Tumor.obsm['X_TNODE'])

Tumor = Tumor[np.argsort(Tumor.obs['ptime'].values), :]

sc.pl.umap(Tumor, color='ptime', show=False, frameon=False)
plt.savefig("Figures/sctour_ptime.pdf",bbox_inches = 'tight')

Tumor.obs['cluster02'] = Tumor.obs['leiden']
cluster02_names = {'0':'Tumor cells',
                   '9':'Tumor cells',
                   '11':'Tumor cells',
                   '14':'Tumor stem cells',
                   '21':'Tumor cells', 
                   '27':'Tumor cells'}
Tumor.obs = Tumor.obs.replace({'cluster02': cluster02_names})

Tumor.layers['counts'] = Tumor.X # Save raw counts

# preprocessing
sc.pp.normalize_total(Tumor, target_sum=1e4)
sc.pp.log1p(Tumor)
Tumor.layers['lognorm'] = Tumor.X

# set STIM as class 0, CTRL as class 1, to make categorical
Tumor.obs['cluster02'] = pd.Categorical(Tumor.obs['cluster02'], categories=["Tumor stem cells", "Tumor cells"], ordered=True)

indices = Tumor.obs.sort_values(['cluster02']).index
Tumor = Tumor[indices,:]

import gseapy as gp
# simple plotting function
from gseapy.plot import barplot, dotplot

names = gp.get_library_name()  # default: Human

res_KEGG = gp.gsea(data=Tumor.to_df().T, # row -> genes, column-> samples
        gene_sets="KEGG_2021_Human",
        cls=Tumor.obs.cluster02,
        permutation_num=1000,
        permutation_type='phenotype',
        outdir=None,
        method='s2n')

res_KEGG.res2d.to_csv('./pancancer/20251201/OOC7/gsea_tumor_KEGG_OOC7.csv')

res_GO = gp.gsea(data=Tumor.to_df().T, # row -> genes, column-> samples
        gene_sets="GO_Biological_Process_2023",
        cls=Tumor.obs.cluster02,
        permutation_num=1000,
        permutation_type='phenotype',
        outdir=None,
        method='s2n', # signal_to_noise
        threads= 16)

res_GO.res2d.to_csv('./pancancer/20251201/OOC7/gsea_tumor_GO_OOC7.csv')
